{
  "name": "tauri-as-electron",
  "version": "0.1.0",
  "description": "Electron-compatible JavaScript API on top of Tauri v2: the tauri-electron library (importable straight from this GitHub repository), a starter template and a kitchen-sink app.",
  "license": "0BSD",
  "repository": "github:AJayClauGermany/tauri-as-electron",
  "type": "module",
  "main": "./packages/tauri-electron/src/index.js",
  "exports": {
    ".": "./packages/tauri-electron/src/index.js",
    "./main": "./packages/tauri-electron/src/index.js",
    "./renderer": "./packages/tauri-electron/src/index.js",
    "./common": "./packages/tauri-electron/src/index.js",
    "./path": "./packages/tauri-electron/src/path.js",
    "./process": "./packages/tauri-electron/src/process.js",
    "./renderer-bootstrap": "./packages/tauri-electron/src/renderer/bootstrap.js",
    "./vite": "./packages/tauri-electron/vite.js",
    "./webpack": "./packages/tauri-electron/webpack.cjs",
    "./rspack": "./packages/tauri-electron/webpack.cjs",
    "./require": "./packages/tauri-electron/src/require.js",
    "./events": "./packages/tauri-electron/src/events.js",
    "./url": "./packages/tauri-electron/src/url.js",
    "./path/win32": "./packages/tauri-electron/src/node/path-win32.js",
    "./buffer": "./packages/tauri-electron/src/node/buffer.js",
    "./fs": "./packages/tauri-electron/src/node/fs.js",
    "./fs/promises": "./packages/tauri-electron/src/node/fs-promises.js",
    "./node": "./packages/tauri-electron/src/node/index.js",
    "./util": "./packages/tauri-electron/src/node/util.js",
    "./util/types": "./packages/tauri-electron/src/node/util-types.js",
    "./string_decoder": "./packages/tauri-electron/src/node/string-decoder.js",
    "./stream": "./packages/tauri-electron/src/node/stream.js",
    "./stream/promises": "./packages/tauri-electron/src/node/stream-promises.js",
    "./os": "./packages/tauri-electron/src/node/os.js",
    "./child_process": "./packages/tauri-electron/src/node/child-process.js",
    "./crypto": "./packages/tauri-electron/src/node/crypto.js",
    "./http": "./packages/tauri-electron/src/node/http.js",
    "./https": "./packages/tauri-electron/src/node/https.js",
    "./assert": "./packages/tauri-electron/src/node/assert.js",
    "./assert/strict": "./packages/tauri-electron/src/node/assert-strict.js",
    "./querystring": "./packages/tauri-electron/src/node/querystring.js",
    "./punycode": "./packages/tauri-electron/src/node/punycode.js",
    "./timers": "./packages/tauri-electron/src/node/timers.js",
    "./timers/promises": "./packages/tauri-electron/src/node/timers-promises.js",
    "./perf_hooks": "./packages/tauri-electron/src/node/perf-hooks.js",
    "./stream/web": "./packages/tauri-electron/src/node/stream-web.js",
    "./stream/consumers": "./packages/tauri-electron/src/node/stream-consumers.js",
    "./zlib": "./packages/tauri-electron/src/node/zlib.js",
    "./constants": "./packages/tauri-electron/src/node/constants.js",
    "./console": "./packages/tauri-electron/src/node/console.js",
    "./module": "./packages/tauri-electron/src/node/module.js",
    "./readline": "./packages/tauri-electron/src/node/readline.js",
    "./readline/promises": "./packages/tauri-electron/src/node/readline-promises.js",
    "./async_hooks": "./packages/tauri-electron/src/node/async-hooks.js",
    "./diagnostics_channel": "./packages/tauri-electron/src/node/diagnostics-channel.js",
    "./tty": "./packages/tauri-electron/src/node/tty.js",
    "./domain": "./packages/tauri-electron/src/node/domain.js"
  },
  "bin": {
    "create-tauri-electron-app": "./scripts/create-app.mjs"
  },
  "files": [
    "packages/tauri-electron/src",
    "packages/tauri-electron/vite.js",
    "packages/tauri-electron/webpack.cjs",
    "packages/tauri-electron/bundler",
    "packages/tauri-electron/README.md",
    "templates/tauri-electron-app",
    "scripts/create-app.mjs",
    "docs"
  ],
  "workspaces": [
    "packages/*",
    "templates/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test --workspace tauri-electron",
    "template:dev": "npm run dev --workspace tauri-electron-app",
    "template:build": "npm run build --workspace tauri-electron-app",
    "kitchen-sink:dev": "npm run dev --workspace kitchen-sink",
    "kitchen-sink:build": "npm run build --workspace kitchen-sink",
    "kitchen-sink:smoke": "npm run smoke --workspace kitchen-sink",
    "create-app": "node scripts/create-app.mjs"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-deep-link": "^2.6.3",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "@tauri-apps/plugin-global-shortcut": "^2.4.0",
    "@tauri-apps/plugin-http": "^2.8.3",
    "@tauri-apps/plugin-notification": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "@tauri-apps/plugin-os": "^2.4.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "buffer": "^6.0.3",
    "fflate": "^0.8.3",
    "punycode": "^2.3.1",
    "readable-stream": "^4.8.0",
    "string_decoder": "^1.3.0"
  }
}
