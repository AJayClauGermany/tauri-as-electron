  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./main": "./src/index.js",
    "./renderer": "./src/index.js",
    "./common": "./src/index.js",
    "./path": "./src/path.js",
    "./process": "./src/process.js",
    "./renderer-bootstrap": "./src/renderer/bootstrap.js",
    "./vite": "./vite.js",
    "./webpack": "./webpack.cjs",
    "./rspack": "./webpack.cjs",
    "./require": "./src/require.js",
    "./events": "./src/events.js",
    "./url": "./src/url.js",
    "./path/win32": "./src/node/path-win32.js",
    "./buffer": "./src/node/buffer.js",
    "./fs": "./src/node/fs.js",
    "./fs/promises": "./src/node/fs-promises.js",
    "./node": "./src/node/index.js",
    "./util": "./src/node/util.js",
    "./util/types": "./src/node/util-types.js",
    "./string_decoder": "./src/node/string-decoder.js",
    "./stream": "./src/node/stream.js",
    "./stream/promises": "./src/node/stream-promises.js",
    "./os": "./src/node/os.js",
    "./child_process": "./src/node/child-process.js",
    "./crypto": "./src/node/crypto.js",
    "./http": "./src/node/http.js",
    "./https": "./src/node/https.js"
  },
  "files": [
    "src",
    "vite.js",
    "webpack.cjs",
    "bundler",
    "README.md"
