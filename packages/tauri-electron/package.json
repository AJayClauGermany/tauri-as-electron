  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-deep-link": "^2.6.3",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "@tauri-apps/plugin-global-shortcut": "^2.4.0",
    "@tauri-apps/plugin-http": "^2.8.3",
    "@tauri-apps/plugin-notification": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "@tauri-apps/plugin-os": "^2.4.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "buffer": "^6.0.3",
    "readable-stream": "^4.8.0",
    "string_decoder": "^1.3.0"
  },
  "devDependencies": {
    "@rspack/core": "^2.3.2",
    "html-webpack-plugin": "^5.6.8",
    "vitest": "^5.1.0",
    "webpack": "^5.112.2"
