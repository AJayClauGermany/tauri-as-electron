{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tauri Electron App",
  "version": "0.1.0",
  "identifier": "com.example.tauri-electron-app",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "electron-main",
        "title": "electron-main",
        "url": "electron-main.html",
        "visible": false,
        "skipTaskbar": true,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "electron-resources/": ""
    }
  }
}
